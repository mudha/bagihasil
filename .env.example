# Database Connection (Get this from Supabase or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# NextAuth Secret (Generate a random string, e.g. using openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ImageKit upload storage
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"
IMAGEKIT_PRIVATE_KEY="your-imagekit-private-key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-account"

# AI parsing
GEMINI_API_KEY="your-gemini-api-key"

# Optional notifications
FONNTE_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="notifications@example.com"
