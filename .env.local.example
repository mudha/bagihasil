# Salin ke .env.local lalu pakai untuk pengembangan lokal.
# JANGAN pernah menaruh URL database produksi (Supabase/Vercel Postgres) di sini.
DATABASE_URL="postgresql://bagihasil:local_only_password@localhost:5433/bagihasil_local"
DIRECT_URL="postgresql://bagihasil:local_only_password@localhost:5433/bagihasil_local"

AUTH_SECRET="local-dev-secret-ganti-bebas"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Opsional. Kosongkan bila tidak perlu: upload foto/bukti dan scan AI tidak akan jalan, fitur lain normal.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
GEMINI_API_KEY=""
